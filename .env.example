 # ─── Base de Datos ───
DB_HOST=mysql
DB_PORT=3306
DB_NAME=rau_toxicity
DB_USER=rau_user
DB_PASSWORD=rau_secure_password_123

# Docker MySQL (used by docker-compose)
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=rau_toxicity
MYSQL_USER=rau_user
MYSQL_PASSWORD=rau_password

# ─── JWT ───
JWT_SECRET_KEY=your_super_secret_key_256bits_minimum_length
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── API de IA ───
AI_PROVIDER=openai                 # openai | perspective | huggingface
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=omni-moderation-latest
PERSPECTIVE_API_KEY=
HUGGINGFACE_API_TOKEN=your_token
TOXICITY_THRESHOLD=0.7            # Umbral para activar moderación
# ─── App ───
APP_ENV=development              # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Frontend (Vite) API URL
VITE_API_URL=http://localhost:8000
